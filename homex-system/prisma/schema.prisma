generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  civilId   String   @unique @map("civil_id")
  phone     String?
  phoneCode String   @default("+968") @map("phone_code")
  role      String   @default("sales")
  password  String
  isActive  Boolean  @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  failedAttempts Int      @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotations    Quotation[]
  customers     Customer[]
  auditLogs     AuditLog[]
  notifications Notification[]
  payments      Payment[]
  invoices      Invoice[]
  expenses      Expense[]

  @@map("employees")
}

// Business costs/expenses (materials, salaries, rent, …) — the cost side of the
// reports P&L. Not tied to a specific order; scoped to the report period by date.
model Expense {
  id        String   @id @default(cuid())
  amount    Float
  category  String   @default("other") // materials | labor | rent | utilities | transport | other
  note      String?
  spentAt   DateTime @default(now()) @map("spent_at")
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  creator Employee @relation(fields: [createdBy], references: [id])

  @@index([spentAt])
  @@map("expenses")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String
  phoneCode   String   @default("+968") @map("phone_code")
  governorate String
  wilayat     String
  address     String?
  createdBy   String   @map("created_by")
  deletedAt   DateTime? @map("deleted_at")
  deletedBy   String?   @map("deleted_by")
  importBatch String?  @map("import_batch")
  // Where this customer came from: null/"sales" (a quotation) or "service"
  // (created straight from a service / return request, no quote yet).
  source      String?  @map("source")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator         Employee         @relation(fields: [createdBy], references: [id])
  quotations      Quotation[]
  serviceRequests ServiceRequest[]

  @@index([createdBy])
  @@index([phone])
  @@map("customers")
}

model Category {
  id          String  @id @default(cuid())
  nameAr      String  @map("name_ar")
  nameEn      String  @map("name_en")
  icon        String?
  pricingType String  @map("pricing_type")
  basePrice   Float?  @map("base_price")
  config      String?
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  items QuoteItem[]

  @@map("categories")
}

model Quotation {
  id            String    @id @default(cuid())
  quoteNumber   String    @unique @map("quote_number")
  customerId    String    @map("customer_id")
  employeeId    String    @map("employee_id")
  status        String    @default("draft")
  statusComment String?   @map("status_comment")
  subtotal      Float     @default(0)
  // Reserved columns (discount feature removed from the UI); kept with
  // defaults so an existing DB isn't forced into a destructive column drop.
  discountType  String    @default("percent") @map("discount_type")
  discountValue Float     @default(0) @map("discount_value")
  discountAmount Float    @default(0) @map("discount_amount")
  vatRate       Float     @default(0.05) @map("vat_rate")
  vatAmount     Float     @default(0) @map("vat_amount")
  total         Float     @default(0)
  advancePct    Float     @default(15) @map("advance_pct")
  advanceAmount Float     @default(0) @map("advance_amount")
  notes         String?
  // Set when a manager edits the quotation after it was locked (invoiced /
  // paid / accepted) — records the justification and moment for the audit trail.
  managerEditNote String? @map("manager_edit_note")
  managerEditedAt DateTime? @map("manager_edited_at")
  // Unguessable token for the public customer view (accept / reject online).
  publicToken   String?   @unique @map("public_token")
  // Electronic contract signature. Captured when the customer accepts — either
  // remotely on the public link or in person on a rep's device. signatureData
  // is a base64 PNG of the drawn signature; signerIp is kept as extra proof.
  signatureData String?   @map("signature_data")
  signerName    String?   @map("signer_name")
  signedAt      DateTime? @map("signed_at")
  signerIp      String?   @map("signer_ip")
  // When an approved quote was converted into a confirmed contract (locks the
  // quote and pushes it onto the work board).
  contractedAt  DateTime? @map("contracted_at")
  deliveryDate  DateTime? @map("delivery_date")
  // True when deliveryDate was ESTIMATED from neighbouring rows during import
  // (the original sheet had no date). Used only to place the row in the right
  // chronological position; the real date is still confirmed/entered manually,
  // and the UI shows a "تقديري" badge until then.
  deliveryDateEstimated Boolean @default(false) @map("delivery_date_estimated")
  // Optional time-of-day for the delivery (stored as "HH:MM"); pairs with
  // deliveryDate to schedule the delivery precisely.
  deliveryTime  String?   @map("delivery_time")
  validUntil    DateTime? @map("valid_until")
  expiryNotified Boolean  @default(false) @map("expiry_notified")
  followUpNotified Boolean @default(false) @map("follow_up_notified")
  workStatus    String?   @map("work_status")
  // Delivery-schedule fields: assigned driver/team name and whether the
  // delivery appointment was confirmed with the customer.
  deliveryDriver String?  @map("delivery_driver")
  // Exact delivery location (a Google Maps link or "lat,lng" the customer
  // sends and customer-service pastes in), so the driver opens the exact pin.
  deliveryLocation String? @map("delivery_location")
  apptConfirmed Boolean   @default(false) @map("appt_confirmed")
  // Actual delivery moment (set when marked delivered) — powers on-time KPIs.
  deliveredAt   DateTime? @map("delivered_at")
  // Installation stage: assigned technician + scheduled date/time + done moment.
  installTechnician String? @map("install_technician")
  installDate   DateTime? @map("install_date")
  installTime   String?   @map("install_time")
  installedAt   DateTime? @map("installed_at")
  hasOrangeAlert Boolean  @default(false) @map("has_orange_alert")
  hasRedAlert    Boolean  @default(false) @map("has_red_alert")
  workNotes     String?   @map("work_notes")
  // Photography track — parallel to delivery/installation. A manager flags a
  // finished (delivered/installed) job "ready for photo", it appears in the
  // photographer's queue with the same location/customer info, and the
  // photographer confirms "photographed" (or sends it back for a re-shoot).
  // null = not flagged · "ready" = in queue · "done" = photographed.
  photoStatus   String?   @map("photo_status")
  photographer  String?   @map("photographer")
  photographedAt DateTime? @map("photographed_at")
  photoNotes    String?   @map("photo_notes")
  woodStatus    String    @default("not_ordered") @map("wood_status")
  fabricStatus  String    @default("not_ordered") @map("fabric_status")
  // Soft delete: when set, the quotation is in the Trash (hidden everywhere)
  // until restored or permanently removed.
  deletedAt     DateTime? @map("deleted_at")
  deletedBy     String?   @map("deleted_by")
  // Bulk import: tags records created by an Excel import so a whole batch can
  // be previewed and undone as a unit.
  importBatch   String?   @map("import_batch")
  // Reference total from the imported sheet — shown while items are added
  // manually so the user can confirm the itemized quote matches the paper.
  importedTotal Float?    @map("imported_total")
  // The original number the order carried before a bulk renumber (e.g. the old
  // sheet number "SW-655"). Kept as a searchable reference so paper records
  // still map to the record after unifying quote numbers.
  originalNumber String?  @map("original_number")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer Customer    @relation(fields: [customerId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])
  items    QuoteItem[]
  payments Payment[]
  invoice  Invoice?
  serviceRequests ServiceRequest[]

  @@index([employeeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([deliveryDate])
  @@index([workStatus])
  // Composite indexes matching the app's real filter+sort patterns, so these
  // hot queries use an index instead of scanning: the work board / delivery
  // schedule (workStatus + deliveryDate), the installation schedule
  // (workStatus + installDate), the quotations list (status + createdAt), and
  // a salesperson's own quotations newest-first (employeeId + createdAt).
  @@index([workStatus, deliveryDate])
  @@index([workStatus, installDate])
  @@index([photoStatus])
  @@index([importBatch])
  @@index([status, createdAt])
  @@index([employeeId, createdAt])
  @@map("quotations")
}

// After-sales return / maintenance visits raised against a delivered order.
model ServiceRequest {
  id            String    @id @default(cuid())
  // Either linked to an existing quotation, or to a customer created straight
  // from the request (a brand-new customer with no quote yet). Both optional.
  quotationId   String?   @map("quotation_id")
  customerId    String?   @map("customer_id")
  type          String    @default("maintenance") // "return" | "maintenance" (more later)
  reason        String?
  status        String    @default("open")        // open | scheduled | resolved
  scheduledDate DateTime? @map("scheduled_date")
  technician    String?
  notes         String?
  createdBy     String    @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  resolvedAt    DateTime? @map("resolved_at")

  quotation Quotation? @relation(fields: [quotationId], references: [id])
  customer  Customer?  @relation(fields: [customerId], references: [id])

  @@index([status])
  @@index([quotationId])
  @@index([customerId])
  @@map("service_requests")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique @map("invoice_number")
  quotationId   String   @unique @map("quotation_id")
  issuedAt      DateTime @default(now()) @map("issued_at")
  issuedBy      String   @map("issued_by")
  createdAt     DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  issuer    Employee  @relation(fields: [issuedBy], references: [id])

  @@map("invoices")
}

model Payment {
  id          String   @id @default(cuid())
  quotationId String   @map("quotation_id")
  amount      Float
  method      String   @default("cash")
  reference   String?
  notes       String?
  paidAt      DateTime @default(now()) @map("paid_at")
  recordedBy  String   @map("recorded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  recorder  Employee  @relation(fields: [recordedBy], references: [id])

  @@index([quotationId])
  @@map("payments")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quotationId String  @map("quotation_id")
  categoryId  String  @map("category_id")
  description String
  details     String?
  // Float (not Int) so measurement-based items (e.g. seating sets priced per
  // metre) can use fractional amounts like 1.5 or 3.4.
  quantity    Float   @default(1)
  unitPrice   Float   @map("unit_price")
  extras      Float   @default(0)
  lineTotal   Float   @map("line_total")
  sortOrder   Int     @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id])
  tasks     ItemTask[]

  @@index([quotationId])
  @@map("quote_items")
}

// A factory worker (carpenter, painter, upholsterer …). Separate from Employee
// (login users) — workers don't sign in; they're just a managed list with a
// colour identity used across the work board and productivity reports.
model Worker {
  id        String   @id @default(cuid())
  name      String
  color     String   @default("#2dd4bf")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  tasks ItemTask[]

  @@map("workers")
}

// One production stage of a single quote item (e.g. the "دهان" stage of a bed),
// assigned to a worker and marked done when finished. An item can have several
// stages in sequence; the set of them forms that item's production pipeline.
model ItemTask {
  id          String    @id @default(cuid())
  quoteItemId String    @map("quote_item_id")
  stage       String    // stage name, e.g. "نجارة" / "دهان" / "تنجيد"
  workerId    String?   @map("worker_id")
  doneAt      DateTime? @map("done_at")
  sortOrder   Int       @default(0) @map("sort_order")
  createdAt   DateTime  @default(now()) @map("created_at")

  quoteItem QuoteItem @relation(fields: [quoteItemId], references: [id], onDelete: Cascade)
  worker    Worker?   @relation(fields: [workerId], references: [id], onDelete: SetNull)

  @@index([quoteItemId])
  @@index([workerId])
  @@map("item_tasks")
}

model AuditLog {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  title      String
  message    String
  type       String   @default("info")
  isRead     Boolean  @default(false) @map("is_read")
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, isRead])
  @@map("notifications")
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model ErrorLog {
  id        String   @id @default(cuid())
  message   String
  digest    String?
  path      String?
  method    String?
  routeType String?  @map("route_type")
  stack     String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("error_logs")
}

model Backup {
  id        String   @id @default(cuid())
  data      String
  size      Int      @default(0)
  source    String   @default("auto")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backups")
}

// Incoming enquiries captured from the public company website's "request a
// quote" form. Kept separate from Customer so unqualified web enquiries don't
// pollute the real customer list; staff review a lead and convert it into a
// Customer when it's genuine. status: new | contacted | converted | archived.
model Lead {
  id          String    @id @default(cuid())
  name        String
  phone       String?
  phoneCode   String    @default("+968") @map("phone_code")
  governorate String?
  wilayat     String?
  service     String?
  message     String?
  source      String    @default("website")
  status      String    @default("new")
  // Staff note added while following up (call summary, next step…).
  note        String?
  // Set when a lead is turned into a real customer, for traceability.
  convertedCustomerId String? @map("converted_customer_id")
  handledBy   String?   @map("handled_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([status])
  @@index([createdAt])
  @@map("leads")
}
