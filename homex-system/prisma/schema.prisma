generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id        String   @id @default(cuid())
  name      String
  civilId   String   @unique @map("civil_id")
  phone     String?
  role      String   @default("sales")
  password  String
  isActive  Boolean  @default(true) @map("is_active")
  lastLogin DateTime? @map("last_login")
  failedAttempts Int      @default(0) @map("failed_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  quotations    Quotation[]
  customers     Customer[]
  auditLogs     AuditLog[]
  notifications Notification[]
  payments      Payment[]
  invoices      Invoice[]

  @@map("employees")
}

model Customer {
  id          String   @id @default(cuid())
  name        String
  phone       String
  phoneCode   String   @default("+968") @map("phone_code")
  governorate String
  wilayat     String
  address     String?
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  creator    Employee    @relation(fields: [createdBy], references: [id])
  quotations Quotation[]

  @@index([createdBy])
  @@index([phone])
  @@map("customers")
}

model Category {
  id          String  @id @default(cuid())
  nameAr      String  @map("name_ar")
  nameEn      String  @map("name_en")
  icon        String?
  pricingType String  @map("pricing_type")
  basePrice   Float?  @map("base_price")
  config      String?
  isActive    Boolean @default(true) @map("is_active")
  sortOrder   Int     @default(0) @map("sort_order")

  items QuoteItem[]

  @@map("categories")
}

model Quotation {
  id            String    @id @default(cuid())
  quoteNumber   String    @unique @map("quote_number")
  customerId    String    @map("customer_id")
  employeeId    String    @map("employee_id")
  status        String    @default("draft")
  statusComment String?   @map("status_comment")
  subtotal      Float     @default(0)
  // Reserved columns (discount feature removed from the UI); kept with
  // defaults so an existing DB isn't forced into a destructive column drop.
  discountType  String    @default("percent") @map("discount_type")
  discountValue Float     @default(0) @map("discount_value")
  discountAmount Float    @default(0) @map("discount_amount")
  vatRate       Float     @default(0.05) @map("vat_rate")
  vatAmount     Float     @default(0) @map("vat_amount")
  total         Float     @default(0)
  advancePct    Float     @default(15) @map("advance_pct")
  advanceAmount Float     @default(0) @map("advance_amount")
  notes         String?
  deliveryDate  DateTime? @map("delivery_date")
  validUntil    DateTime? @map("valid_until")
  expiryNotified Boolean  @default(false) @map("expiry_notified")
  workStatus    String?   @map("work_status")
  hasOrangeAlert Boolean  @default(false) @map("has_orange_alert")
  hasRedAlert    Boolean  @default(false) @map("has_red_alert")
  workNotes     String?   @map("work_notes")
  woodStatus    String    @default("not_ordered") @map("wood_status")
  fabricStatus  String    @default("not_ordered") @map("fabric_status")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  customer Customer    @relation(fields: [customerId], references: [id])
  employee Employee    @relation(fields: [employeeId], references: [id])
  items    QuoteItem[]
  payments Payment[]
  invoice  Invoice?

  @@index([employeeId])
  @@index([customerId])
  @@index([status])
  @@index([createdAt])
  @@index([deliveryDate])
  @@index([workStatus])
  @@map("quotations")
}

model Invoice {
  id            String   @id @default(cuid())
  invoiceNumber String   @unique @map("invoice_number")
  quotationId   String   @unique @map("quotation_id")
  issuedAt      DateTime @default(now()) @map("issued_at")
  issuedBy      String   @map("issued_by")
  createdAt     DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  issuer    Employee  @relation(fields: [issuedBy], references: [id])

  @@map("invoices")
}

model Payment {
  id          String   @id @default(cuid())
  quotationId String   @map("quotation_id")
  amount      Float
  method      String   @default("cash")
  reference   String?
  notes       String?
  paidAt      DateTime @default(now()) @map("paid_at")
  recordedBy  String   @map("recorded_by")
  createdAt   DateTime @default(now()) @map("created_at")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  recorder  Employee  @relation(fields: [recordedBy], references: [id])

  @@index([quotationId])
  @@map("payments")
}

model QuoteItem {
  id          String  @id @default(cuid())
  quotationId String  @map("quotation_id")
  categoryId  String  @map("category_id")
  description String
  details     String?
  quantity    Int     @default(1)
  unitPrice   Float   @map("unit_price")
  extras      Float   @default(0)
  lineTotal   Float   @map("line_total")
  sortOrder   Int     @default(0) @map("sort_order")

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id])

  @@index([quotationId])
  @@map("quote_items")
}

model AuditLog {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  action     String
  entity     String
  entityId   String?  @map("entity_id")
  details    String?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Notification {
  id         String   @id @default(cuid())
  employeeId String   @map("employee_id")
  title      String
  message    String
  type       String   @default("info")
  isRead     Boolean  @default(false) @map("is_read")
  link       String?
  createdAt  DateTime @default(now()) @map("created_at")

  employee Employee @relation(fields: [employeeId], references: [id])

  @@index([employeeId, isRead])
  @@map("notifications")
}

model Settings {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model Backup {
  id        String   @id @default(cuid())
  data      String
  size      Int      @default(0)
  source    String   @default("auto")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("backups")
}
