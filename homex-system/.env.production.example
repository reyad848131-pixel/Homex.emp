# ============================================
# Homex - Production Environment
# ============================================
# Copy to .env.production on your server
# ============================================

# Database
DB_PROVIDER=postgresql
DB_USER=homex
DB_PASSWORD=CHANGE_TO_STRONG_PASSWORD
DB_NAME=homex_prod
DATABASE_URL=postgresql://homex:CHANGE_TO_STRONG_PASSWORD@db:5432/homex_prod

# Auth secret - generate with: openssl rand -base64 32
NEXTAUTH_SECRET=CHANGE_TO_RANDOM_SECRET

# Your domain (with https)
NEXTAUTH_URL=https://your-domain.com

# Port
PORT=3000
