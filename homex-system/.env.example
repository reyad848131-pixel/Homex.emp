# ============================================
# Homex System - Environment Variables
# ============================================
# Copy this file to .env and fill in the values
# NEVER commit .env to git
# ============================================

# --- Database ---
# PostgreSQL connection string
# Development: postgresql://homex:homex123@localhost:5432/homex_dev
# Production:  postgresql://homex:STRONG_PASSWORD@db:5432/homex_prod
DATABASE_URL="postgresql://homex:homex123@localhost:5432/homex_dev"

# --- Authentication ---
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_TO_RANDOM_SECRET"

# Full URL where the app is hosted
# Development: http://localhost:3000
# Production:  https://your-domain.com
NEXTAUTH_URL="http://localhost:3000"

# --- Application ---
# "development" or "production"
NODE_ENV="development"

# Server port (default: 3000)
PORT=3000
